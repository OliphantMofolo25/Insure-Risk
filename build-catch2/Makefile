src/sqlite3.s: src/sqlite3.c.s
.PHONY : src/sqlite3.s

# target to generate assembly for a file
src/sqlite3.c.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/InsureRiskLinux.dir/build.make CMakeFiles/InsureRiskLinux.dir/src/sqlite3.c.s
.PHONY : src/sqlite3.c.s

test.o: test.cpp.o
.PHONY : test.o

# target to build an object file
test.cpp.o:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/catch_tests.dir/build.make CMakeFiles/catch_tests.dir/test.cpp.o
.PHONY : test.cpp.o

test.i: test.cpp.i
.PHONY : test.i

# target to preprocess a source file
